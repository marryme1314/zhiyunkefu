# MySQL（本机已有实例，或 docker compose 启动后的实例）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai_cs
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2
OLLAMA_EMBED_MODEL=nomic-embed-text

# JWT（请改成随机长字符串）
JWT_SECRET=please-change-this-to-a-long-random-secret
JWT_EXPIRE_HOURS=72

# 对话模型：moonshot=月之暗面云 API，ollama=本机
LLM_PROVIDER=moonshot
EMBED_PROVIDER=auto
# auto：优先本机 Ollama nomic-embed-text（语义向量）；连不上再退回词法向量。
# 强制词法：local。月之暗面 Embedding 多数 Key 未开通，不要设 moonshot。
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_CHAT_MODEL=kimi-k2.6
MOONSHOT_EMBED_MODEL=moonshot-v3-embedding
