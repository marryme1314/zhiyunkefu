# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=ai_cs
MYSQL_USER=root
MYSQL_PASSWORD=ai_cs_dev

# JWT（prod 要求至少 32 位；不要使用 please-change / replace-this 这类示例前缀）
JWT_SECRET=replace-this-with-a-random-string-of-32chars
JWT_EXPIRE_HOURS=12

# 管理员（生产环境禁止再用 Admin123!）
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=SetAStrongAdminPass1!
ADMIN_RESET_PASSWORD=false
ADMIN_LOG_CREDENTIALS=false

# 对话：moonshot 或 ollama
LLM_PROVIDER=moonshot
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_CHAT_MODEL=kimi-k2.6

# 向量：auto 会按 OpenAI兼容 API → Ollama → 本机词法 依次尝试
EMBED_PROVIDER=auto
EMBED_API_KEY=
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2
OLLAMA_EMBED_MODEL=nomic-embed-text

# 生产 Compose 会覆盖为容器内地址；本地 IDE 运行可留空（走 MySQL 内存索引）
QDRANT_URL=
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

APP_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
