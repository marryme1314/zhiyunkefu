# MySQL（Compose 会把容器内端口映射到本机 3307）
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=ai_cs
MYSQL_USER=root
MYSQL_PASSWORD=ai_cs_dev

# JWT：至少 32 位。不要用 please-change / replace-this 开头（prod 会拒绝启动）
JWT_SECRET=zhiyun-cs-jwt-secret-key-32chars-min!!
JWT_EXPIRE_HOURS=12

# 管理员（Docker prod 禁止 Admin123!）
# 第一次部署请保持 ADMIN_RESET_PASSWORD=true，登录成功后改回 false
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=SetAStrongAdminPass1!
ADMIN_RESET_PASSWORD=true
ADMIN_LOG_CREDENTIALS=false

# 对话：moonshot 需要填 Key；没有 Key 就改成 ollama，并本机安装 Ollama + qwen2
LLM_PROVIDER=moonshot
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_CHAT_MODEL=kimi-k2.6

# 向量：auto = OpenAI兼容 API → Ollama nomic-embed-text → 本机词法回退
EMBED_PROVIDER=auto
EMBED_API_KEY=
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2
OLLAMA_EMBED_MODEL=nomic-embed-text

# 本机 IDE 开发可不填；Docker Compose 会覆盖为容器内地址
QDRANT_URL=
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

APP_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://localhost,http://127.0.0.1
